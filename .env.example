# Copiar a .env.local y completar.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic (interpretaciones con IA) ---
ANTHROPIC_API_KEY=sk-ant-...
# Solo si la clave es de alcance "Organización" (sk-ant-usr-...): id del espacio de trabajo (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# Modelo por defecto para lecturas. Ver src/lib/ia.ts
# Modelos: "premium" para carta astral, Cruz Celta, quiromancia y lecturas cruzadas;
# "estandar" para el resto (carta del día, Sibila, preguntas, numerología, I Ching, chino, compatibilidad).
# ARCANA_IA_MODEL=claude-sonnet-5-5   # si se define, fuerza ese modelo para TODO (fase de prueba)
ARCANA_IA_MODEL_PREMIUM=claude-opus-5-5
ARCANA_IA_MODEL_ESTANDAR=claude-sonnet-5-5

# --- Bold (pagos Colombia). Panel de Bold -> Integraciones -> Botón de pagos ---
# Llave de identidad (pública) y llave secreta. Usa las de pruebas mientras pruebas.
NEXT_PUBLIC_BOLD_API_KEY=
BOLD_SECRET_KEY=
# "test" o "production" (en pruebas Bold firma el webhook con llave vacía)
# CAPTCHA (Cloudflare Turnstile): la clave del sitio va aquí; la secreta se configura en Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

BOLD_ENV=test
# Solo en local: acepta la firma vacía del sandbox de Bold en el webhook (nunca en producción).
# BOLD_ACEPTAR_FIRMA_VACIA=1

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Correos de Sibila (Resend). Sin RESEND_API_KEY no se envía nada. ---
RESEND_API_KEY=
# Remitente con dominio verificado en Resend
CORREO_REMITENTE="Sibila de Arcana <sibila@miarcana.com>"
# Buzón real que recibe las respuestas (por defecto miarcana4@gmail.com).
# CORREO_RESPUESTA=
# Tope de correos por corrida del cron (plan gratuito de Resend: 100 al día)
CORREOS_MAXIMO=80
# Opcional: clave propia para firmar los enlaces de baja (por defecto se deriva de la service role)
# CORREO_SECRETO=

# --- Pagos internacionales (Lemon Squeezy, fuera de Colombia). Sin estas variables se sigue cobrando con Bold. ---
LEMON_API_KEY=
LEMON_STORE_ID=
LEMON_WEBHOOK_SECRET=
# Id de variante de cada producto en Lemon Squeezy: "prueba:111,inicial:123,buscador:456,iniciado:789,circulo:012,fundadores:013"
LEMON_VARIANTES=

# --- Facebook (carta del día en la página "Mi Arcana"). Reutiliza IG_PAGE_TOKEN si no hay FB_PAGE_TOKEN. ---
FB_PAGE_ID=61594894293890
# FB_PAGE_TOKEN=

# Agente de redes: correos (separados por coma) que pueden entrar a /admin/redes
# y reciben el aviso semanal de borradores.
ADMIN_CORREOS=
