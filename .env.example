# Copiar a .env.local y completar.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic (interpretaciones con IA) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo por defecto para lecturas. Ver src/lib/ia.ts
ARCANA_IA_MODEL=claude-sonnet-5-5

# --- Wompi (pagos Colombia). Sandbox: https://sandbox.wompi.co ---
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_INTEGRITY_SECRET=test_integrity_...
WOMPI_EVENTS_SECRET=test_events_...
# "sandbox" o "production"
WOMPI_ENV=sandbox

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
